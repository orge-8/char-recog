{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages",
    "image_upload"
  ],
  "workspace_title": "角色识别",
  "pages": [
    {
      "id": "images",
      "title": "图片标注",
      "placement": "workspace",
      "icon": "database",
      "description": "按角色上传、标注与管理训练图片。",
      "mode": "custom",
      "entry": "webui/images.html",
      "queries": {
        "pictures": {
          "api": "self_images",
          "version": "1",
          "parameters": {
            "page": {
              "type": "integer",
              "required": false,
              "minimum": 1
            },
            "view": {
              "type": "string",
              "required": false,
              "choices": [
                "all",
                "eligible",
                "excluded",
                "unlabelled",
                "errors",
                "removed"
              ]
            },
            "job_id": {
              "type": "string",
              "required": false
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "form": {
          "api": "self_training_form",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "jobs": {
          "api": "self_training_jobs",
          "parameters": {}
        },
        "report": {
          "api": "self_training_report",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": false
            }
          }
        },
        "versions": {
          "api": "self_models",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "results": {
          "api": "self_test_result",
          "parameters": {}
        },
        "env": {
          "api": "self_environment",
          "parameters": {}
        },
        "characters": {
          "api": "self_characters",
          "parameters": {}
        },
        "ui": {
          "api": "self_ui",
          "version": "1",
          "parameters": {}
        }
      },
      "actions": {
        "upload": {
          "api": "self_upload",
          "version": "1",
          "parameters": {
            "upload_id": {
              "type": "string",
              "required": true
            },
            "upload_label": {
              "type": "string",
              "required": true,
              "choices": [
                "self",
                "other"
              ]
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "batch_positive": {
          "api": "self_images_batch_positive",
          "parameters": {
            "image_ids": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          },
          "confirmation": "确认批量标为是该角色所有已选图片（包括其他页）？"
        },
        "batch_negative": {
          "api": "self_images_batch_negative",
          "parameters": {
            "image_ids": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          },
          "confirmation": "确认批量标为不是该角色所有已选图片（包括其他页）？"
        },
        "batch_remove": {
          "api": "self_images_batch_remove",
          "parameters": {
            "image_ids": {
              "type": "string",
              "required": true,
              "max_length": 65536
            }
          },
          "confirmation": "确认批量删除所有已选图片（包括其他页）？"
        },
        "remove_all": {
          "api": "self_images_remove_all",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          },
          "confirmation": "确认删除当前角色图片库中全部未删除图片？仅当前角色受影响，其他角色与已训练模型保留；图片可在已删除列表恢复。"
        },
        "label": {
          "api": "self_label",
          "parameters": {
            "image_id": {
              "type": "string",
              "required": true
            },
            "label": {
              "type": "string",
              "required": true,
              "choices": [
                "self",
                "other"
              ]
            }
          }
        },
        "remove": {
          "api": "self_image_remove",
          "parameters": {
            "image_id": {
              "type": "string",
              "required": true
            }
          }
        },
        "restore": {
          "api": "self_image_restore",
          "parameters": {
            "image_id": {
              "type": "string",
              "required": true
            }
          }
        },
        "test_upload": {
          "api": "self_test_upload",
          "version": "1",
          "parameters": {
            "upload_id": {
              "type": "string",
              "required": true
            },
            "result_id": {
              "type": "string",
              "required": false,
              "max_length": 32
            }
          }
        },
        "ui_save": {
          "api": "self_ui_save",
          "version": "1",
          "parameters": {
            "state": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        }
      },
      "uploads": {
        "library": {
          "action": "upload",
          "image_max_edge": 4000
        },
        "recognition": {
          "action": "test_upload",
          "image_max_edge": 4000
        }
      }
    },
    {
      "id": "capture",
      "title": "待确认",
      "placement": "workspace",
      "icon": "list",
      "description": "逐组确认聊天里模型拿不准的图片，默认汇总全部角色；确认后才写入训练真值。",
      "mode": "custom",
      "entry": "webui/capture.html",
      "queries": {
        "pictures": {
          "api": "self_images",
          "version": "1",
          "parameters": {
            "page": {
              "type": "integer",
              "required": false,
              "minimum": 1
            },
            "view": {
              "type": "string",
              "required": false,
              "choices": [
                "all",
                "eligible",
                "excluded",
                "unlabelled",
                "errors",
                "removed",
                "captured"
              ]
            },
            "job_id": {
              "type": "string",
              "required": false
            },
            "character": {
              "type": "string",
              "required": false,
              "max_length": 32
            }
          }
        },
        "versions": {
          "api": "self_models",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "env": {
          "api": "self_environment",
          "parameters": {}
        },
        "characters": {
          "api": "self_characters",
          "parameters": {}
        },
        "ui": {
          "api": "self_ui",
          "version": "1",
          "parameters": {}
        }
      },
      "actions": {
        "capture_confirm": {
          "api": "self_capture_confirm",
          "parameters": {
            "image_id": {
              "type": "string",
              "required": true
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            },
            "label": {
              "type": "string",
              "required": true,
              "choices": [
                "self",
                "other"
              ]
            }
          }
        },
        "capture_undo": {
          "api": "self_capture_undo",
          "parameters": {
            "image_id": {
              "type": "string",
              "required": true
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "capture_purge": {
          "api": "self_capture_purge",
          "parameters": {
            "image_id": {
              "type": "string",
              "required": true
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          },
          "confirmation": "彻底删除这张聊天捕获？图片文件也会被删除，无法恢复。若只是想标记，请用 1–4 确认。"
        },
        "capture_cleanup": {
          "api": "self_capture_cleanup",
          "parameters": {
            "character": {
              "type": "string",
              "required": false,
              "max_length": 32
            }
          },
          "confirmation": "清理当前可见范围内已被自动排除的旧聊天捕获？会删除记录和图片文件，不影响人工标注的图片。"
        },
        "ui_save": {
          "api": "self_ui_save",
          "version": "1",
          "parameters": {
            "state": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        }
      }
    },
    {
      "id": "training",
