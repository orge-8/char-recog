        "ui": {
          "api": "self_ui",
          "version": "1",
          "parameters": {}
        }
      },
      "actions": {
        "submit": {
          "api": "self_training_submit",
          "parameters": {
            "request_key": {
              "type": "string",
              "required": true
            },
            "mode": {
              "type": "string",
              "required": true
            },
            "device": {
              "type": "string",
              "required": true
            },
            "input_size": {
              "type": "integer",
              "required": false,
              "choices": [
                224,
                320,
                448
              ]
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          },
          "confirmation": "冻结当前标注和数据，开始新训练任务？"
        },
        "pause": {
          "api": "self_training_pause",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true
            }
          },
          "confirmation": "保存断点并暂停？"
        },
        "resume": {
          "api": "self_training_resume",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true
            }
          }
        },
        "cancel": {
          "api": "self_training_cancel",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true
            }
          },
          "confirmation": "确认取消此任务？"
        },
        "delete_jobs": {
          "api": "self_training_delete",
          "version": "1",
          "parameters": {
            "jobs": {
              "type": "string",
              "required": true,
              "max_length": 2048
            }
          }
        },
        "eval_rebuild": {
          "api": "self_eval_rebuild",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          },
          "confirmation": "重建评估集会用当前图片重新挑选，历史报告不再可比。确认继续？"
        },
        "apply_threshold": {
          "api": "self_threshold_apply",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            },
            "value": {
              "type": "string",
              "required": true,
              "max_length": 8
            }
          },
          "confirmation": "确认修改该角色的判定阈值？模型权重不变，只影响之后的自动提示、工具判定与错判列表。"
        },
        "reset_threshold": {
          "api": "self_threshold_reset",
          "parameters": {
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          },
          "confirmation": "恢复该角色的默认判定阈值（0.60）？"
        },
        "test_upload": {
          "api": "self_test_upload",
          "version": "1",
          "parameters": {
            "upload_id": {
              "type": "string",
              "required": true
            },
            "result_id": {
              "type": "string",
              "required": false,
              "max_length": 32
            }
          }
        },
        "upload": {
          "api": "self_upload",
          "version": "1",
          "parameters": {
            "upload_id": {
              "type": "string",
              "required": true
            },
            "upload_label": {
              "type": "string",
              "required": true,
              "choices": [
                "self",
                "other"
              ]
            },
            "character": {
              "type": "string",
              "required": true,
              "max_length": 32
            }
          }
        },
        "ui_save": {
          "api": "self_ui_save",
          "version": "1",
          "parameters": {
            "state": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        }
      },
      "uploads": {
        "library": {
          "action": "upload",
          "image_max_edge": 4000
        },
        "recognition": {
          "action": "test_upload",
          "image_max_edge": 4000
        }
      }
